# VM only: copy to apps/api/.env with permissions 600. Never commit real values.
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://ragchatbot.dev
BETTER_AUTH_URL=https://api.ragchatbot.dev
# Generate independent random hex values; use same DB password in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://rag:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/rag_chatbot
BETTER_AUTH_SECRET=
GEMINI_API_KEY=
MAX_UPLOAD_SIZE_MB=20
MAX_PASTE_LENGTH=500000
CHAT_TIMEOUT_MS=90000
