{
  "name": "document-rag-chatbot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "report:build": "cd report && latexmk",
    "mobile:apk": "cd apps/mobile && pnpm dlx eas-cli@24.5.0 build --platform android --profile preview",
    "mobile:apk:config": "cd apps/mobile && pnpm dlx eas-cli@24.5.0 config --platform android --profile preview",
    "env:check": "bash scripts/check-environment.sh",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@babel/code-frame": "7.29.7",
    "nanoid": "3.3.12",
    "turbo": "latest"
  }
}
